# Postgres connection strings, named to match exactly what Vercel's Neon
# integration injects automatically when you connect a Neon database to the
# project (Storage tab -> Create Database -> Neon) — no manual copying of
# connection strings needed once it's connected:
#   POSTGRES_PRISMA_URL     -> pooled connection, pre-formatted for Prisma (used at runtime)
#   DATABASE_URL_UNPOOLED   -> direct connection (used for migrations)
# If you're on Supabase or another provider instead, set these two to
# whatever pooled/direct connection strings it gives you.
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/starflare"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/starflare"

# Vercel Blob — required in production for uploaded documents to persist.
# Create a Blob store in your Vercel project (Storage tab) and connect it;
# Vercel injects this automatically for deployed environments. Without it,
# uploads fall back to local disk, which is fine for local development but
# does NOT persist on Vercel (its filesystem is ephemeral).
BLOB_READ_WRITE_TOKEN=

# Optional: protects the daily automatic-backup cron endpoint
# (/api/cron/backup). Set any long random string here and in Vercel — Vercel
# Cron sends it as `Authorization: Bearer <CRON_SECRET>`, and the endpoint
# rejects calls that don't match. If unset, the endpoint runs unguarded.
CRON_SECRET=

# Password gate. Set APP_PASSWORD to require a password to open the app. When it
# is empty the app is open (no login). AUTH_SECRET signs the login cookie — set
# it to any long random string in production; if omitted the password is used to
# sign instead. On iPhone, save the password to iCloud Keychain to unlock with
# Face ID.
APP_PASSWORD=
AUTH_SECRET=

# Optional: configure SMTP to actually send invoice emails.
# Without these, invoices are still marked "sent" in the system, but no
# email is delivered — download the PDF and send it manually instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
