# Postgres connection strings. On Vercel, provision a Postgres database
# (Vercel Postgres, Neon, or Supabase all work) and copy both the pooled
# and direct connection strings it gives you:
#   DATABASE_URL  -> the pooled/pgbouncer connection string (used at runtime)
#   DIRECT_URL    -> the direct connection string (used for migrations)
# If your provider only gives you one URL, use it for both.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starflare"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/starflare"

# Vercel Blob — required in production for uploaded documents to persist.
# Create a Blob store in your Vercel project (Storage tab) and connect it;
# Vercel injects this automatically for deployed environments. Without it,
# uploads fall back to local disk, which is fine for local development but
# does NOT persist on Vercel (its filesystem is ephemeral).
BLOB_READ_WRITE_TOKEN=

# Optional: configure SMTP to actually send invoice emails.
# Without these, invoices are still marked "sent" in the system, but no
# email is delivered — download the PDF and send it manually instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
