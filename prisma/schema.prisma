generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // These match the exact env var names Vercel's Neon integration injects
  // automatically (POSTGRES_PRISMA_URL is pre-formatted for Prisma's pooled
  // connections; DATABASE_URL_UNPOOLED is the direct one migrations need) —
  // no manual copying of connection strings required once Neon is connected.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ------------------------------------------------------------------
// Shared / cross-cutting
// ------------------------------------------------------------------

// A generic "actor" pattern is embedded as scalar fields (actorType, actorLabel,
// actorPersonId) directly on the models that need "who did this" or "who is
// linked to this", rather than a heavyweight permissions/user model.

model Counter {
  id    String @id // e.g. "invoice-2026"
  value Int    @default(0)
}

model Document {
  id               String    @id @default(cuid())
  fileName         String
  storedPath       String
  mimeType         String
  fileSize         Int
  checksum         String // sha256, for duplicate detection
  documentType     String // RECEIPT, CLIENT_INVOICE, STRIPE_INVOICE, RECEIVED_INVOICE, BANK_STATEMENT, BANK_DOCUMENT, HR_DOCUMENT, TAX_DOCUMENT, RENT_CONTRACT, RECEIVED_CONTRACT, SENT_CONTRACT, POLICY, OTHER
  category         String? // free-form / suggested category
  tags             String? // comma separated

  ocrStatus        String    @default("PENDING") // PENDING, DONE, FAILED, NEEDS_REVIEW
  ocrText          String?
  ocrConfidence    Float? // 0..1 average confidence
  extractedFields  String? // JSON blob of {field: {value, confidence}}

  status           String    @default("ACTIVE") // ACTIVE, ARCHIVED, EXPIRED, MISSING_INFO, NEEDS_REVIEW
  expiryDate       DateTime?

  // linkage (all optional, a document can relate to at most one primary record)
  personId         String?
  clientId         String?
  invoiceId        String?
  receivedInvoiceId String?
  bankTransactionId String?
  bankStatementId  String?
  taxRecordId      String?
  rentRecordId     String?
  receivedContractId String?
  sentContractId   String?
  policyId         String?
  expenseId        String?
  reimbursementId  String?
  compensationPaymentId String?
  paymentId        String?
  ledgerEntryId    String?

  uploadedByType   String? // actor type
  uploadedByLabel  String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([documentType])
  @@index([status])
  @@index([checksum])
}

model Deadline {
  id            String    @id @default(cuid())
  title         String
  category      String // Invoice, Contract, HR, Tax, Rent, License, Visa, Policy, Other...
  date          DateTime
  status        String    @default("UPCOMING") // UPCOMING, DUE_SOON, OVERDUE, COMPLETED, CANCELLED
  autoGenerated Boolean   @default(false)
  notes         String?

  // source linkage for "link back to original document/record"
  sourceModule  String? // e.g. "ReceivedInvoice", "Person", "RentRecord"
  sourceId      String?
  documentId    String?

  relatedPersonId String?
  relatedClientId  String?
  relatedVendor    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([date])
  @@index([status])
  @@index([sourceModule, sourceId])
}

model AuditLog {
  id               String   @id @default(cuid())
  action           String // e.g. "created", "updated", "status_changed", "deleted", "uploaded"
  section          String // e.g. "Billing", "HR", "Documents"
  recordType       String
  recordId         String
  summary          String
  previousValue    String? // JSON
  newValue         String? // JSON
  performedByType  String?
  performedByLabel String?
  createdAt        DateTime @default(now())

  @@index([section])
  @@index([recordType, recordId])
  @@index([createdAt])
}

// ------------------------------------------------------------------
// 2. Quick Expense Scanner
// ------------------------------------------------------------------

model Expense {
  id               String    @id @default(cuid())
  actorType        String // OSCAR, CRISTINA, EMPLOYEE, FREELANCER, INTERN, CONTRACTOR, OTHER
  actorLabel       String
  personId         String?

  vendor           String?
  expenseDate      DateTime?
  referenceDate    DateTime?
  amount           Float?
  currency         String    @default("AED")
  vat              Float?
  taxRegNumber     String?
  paymentMethod    String? // Company card, Personal card, Cash, Bank transfer, Stripe, Other
  receiptNumber    String?
  description      String?
  category         String? // Office, Travel, Food & Beverage, Software, Marketing, Transport, Client meeting, Creator/campaign cost, Government/tax, Bank fee, Rent/office, Legal/admin, Other

  reimbursable     Boolean   @default(false)
  reimbursePersonId String?
  reimburseAmount  Float?

  status           String    @default("DRAFT") // DRAFT, RECORDED, REIMBURSABLE, REIMBURSED, PAID, NOT_REIMBURSABLE, NEEDS_REVIEW
  notes            String?

  documentId       String?

  clientId         String?
  campaignRef      String?
  receivedInvoiceId String?
  contractType     String? // RECEIVED / SENT, for contract link
  contractId       String?
  bankTransactionId String?
  ledgerEntryId    String?

  duplicateOfId    String?
  possibleDuplicate Boolean  @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([vendor])
  @@index([expenseDate])
}

// ------------------------------------------------------------------
// 3. Billing / Client Invoices
// ------------------------------------------------------------------

model Invoice {
  id                String    @id @default(cuid())
  number            String    @unique // SF-2026-0001

  clientId          String?
  clientNameSnapshot String?
  clientCompanySnapshot String?
  clientEmailSnapshot String?
  clientAddressSnapshot String?
  clientTRNSnapshot String?

  invoiceDate       DateTime
  dueDate           DateTime?

  description       String?
  purchaseId        String?

  quantity          Float     @default(1)
  unitPrice         Float     @default(0)
  vat               Float     @default(0)
  total             Float     @default(0)
  currency          String    @default("AED")

  paymentMethod     String? // Stripe, Bank transfer, Cash, Other
  status            String    @default("DRAFT") // DRAFT, SENT, PAID, PARTIALLY_PAID, OVERDUE, CANCELLED

  receiptDocumentId String?
  notes             String?

  contractType      String? // RECEIVED / SENT
  contractId        String?

  source            String    @default("MANUAL") // MANUAL, STRIPE
  sourceStripeDocumentId String? // original stripe invoice doc

  ledgerEntryId     String?

  sentAt            DateTime?
  sentToEmail       String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([dueDate])
}

// A rich, document-first quotation/invoice generated by the document builder
// (mirrors Starflare's branded quotation layout). The same model backs both a
// Quotation and an Invoice document — they differ only by `kind` (and the
// title on the rendered page). When kind = INVOICE it can also be linked to a
// tracked billing Invoice via `invoiceId` so it counts toward revenue/KPI.
model Quotation {
  id       String @id @default(cuid())
  kind     String @default("QUOTATION") // QUOTATION or INVOICE
  number   String @unique

  // Client
  clientId      String?
  companyName   String?
  brandName     String?
  contactPerson String?
  clientTrn     String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?

  // Package
  packageType        String?
  packageName        String?
  venues             Int?
  coverage           String?
  campaigns          Int?
  creators           Int?
  creatorType        String?
  subjectLine        String?
  includePackageList Boolean @default(true)
  packageAccessItems String? // JSON array of chosen fixed access lines; null = all

  // Pricing & payment
  price            Float   @default(0)
  currency         String  @default("AED")
  vatMode          String  @default("EXCLUDED") // EXCLUDED (add on top), INCLUDED, NONE
  vatPercent       Float   @default(5)
  paymentMethod    String?
  paymentFrequency String?
  paymentTerms     String?
  extraLineItems   String? // JSON array of { description, qty, rate }

  // Term & renewal
  initialTerm             String?
  startDate               DateTime?
  autoRenewal             Boolean   @default(true)
  cancellationViaPlatform Boolean   @default(true)

  // Refund
  refundPolicy String?

  // Special conditions & signatories
  discount           String?
  exclusivity        String?
  paidMediaIncluded  Boolean @default(false)
  extraUsageRights   Boolean @default(false)
  otherNotes         String?
  starflareSignatory String?
  signatoryTitle     String?
  clientSignatory    String?

  // Meta
  docDate    DateTime  @default(now())
  validUntil DateTime?
  status     String    @default("DRAFT")
  invoiceId  String? // linked billing Invoice when kind = INVOICE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([status])
}

// ------------------------------------------------------------------
// 4. Clients / Purchases / Subscriptions
// ------------------------------------------------------------------

model Client {
  id                 String   @id @default(cuid())
  name               String
  companyName        String?
  tradeLicenseNumber String?
  trn                String?
  mainContact        String?
  mainEmail          String?
  billingEmail       String?
  phone              String?
  address            String?
  website            String?
  status             String   @default("LEAD") // LEAD, ACTIVE, PAUSED, CANCELLED, INACTIVE
  notes              String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([name])
}

model Purchase {
  id              String   @id @default(cuid())
  clientId        String
  type            String // SUBSCRIPTION, CREDIT_PACKAGE, SINGLE_CAMPAIGN, SETUP_FEE, RENEWAL, CUSTOM_PACKAGE, OTHER
  date            DateTime
  amount          Float
  currency        String   @default("AED")
  paymentMethod   String?
  invoiceId       String?
  contractType    String?
  contractId      String?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId])
}

model Subscription {
  id            String   @id @default(cuid())
  clientId      String
  packageName   String
  startDate     DateTime
  endDate       DateTime?
  renewalDate   DateTime?
  price         Float
  currency      String   @default("AED")
  status        String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, PENDING_RENEWAL
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ------------------------------------------------------------------
// 5. Payments & Reconciliation
// ------------------------------------------------------------------

model Payment {
  id                  String   @id @default(cuid())
  type                String // INCOMING, OUTGOING
  amount              Float
  currency            String   @default("AED")
  date                DateTime
  method              String?
  payer               String?
  payee               String?

  invoiceId           String?
  receivedInvoiceId   String?
  clientId            String?
  vendorName          String?
  personId            String? // HR comp / reimbursement
  compensationPaymentId String?
  reimbursementId     String?
  expenseId           String?

  proofDocumentId     String?
  bankTransactionId   String?
  stripeTransactionRef String?

  reconciliation      String   @default("UNMATCHED") // MATCHED, UNMATCHED, PARTIALLY_MATCHED, PENDING_REVIEW
  notes               String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([type])
  @@index([reconciliation])
  @@index([date])
}

// ------------------------------------------------------------------
// 6. Received Invoices / Supplier Expenses
// ------------------------------------------------------------------

model ReceivedInvoice {
  id               String    @id @default(cuid())
  vendorName       String?
  vendorCategory   String?
  invoiceNumber    String?
  invoiceDate      DateTime?
  dueDate          DateTime?
  amount           Float?
  vat              Float?
  currency         String    @default("AED")
  description      String?
  expenseCategory  String?
  taxRegNumber     String?

  paymentStatus    String    @default("RECEIVED") // RECEIVED, PENDING_PAYMENT, PAID, OVERDUE, CANCELLED
  receiptDocumentId String?
  documentId       String?

  bankTransactionId String?
  ledgerEntryId    String?
  contractType     String?
  contractId       String?

  recurring        Boolean   @default(false)
  notes            String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([paymentStatus])
  @@index([dueDate])
}

// ------------------------------------------------------------------
// 7. Bank / Bank Documents
// ------------------------------------------------------------------

model BankStatement {
  id             String    @id @default(cuid())
  bankName       String?
  accountName    String?
  iban           String?
  periodStart    DateTime?
  periodEnd      DateTime?
  openingBalance Float?
  closingBalance Float?
  documentId     String?
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BankTransaction {
  id              String    @id @default(cuid())
  bankStatementId String?
  date            DateTime
  description     String?
  moneyIn         Float     @default(0)
  moneyOut        Float     @default(0)
  balanceAfter    Float?

  category        String? // Client payment, Supplier payment, HR payment, Reimbursement, Bank fee, Tax/government, Rent, Software, Marketing, Other
  reconciliation  String    @default("UNMATCHED") // MATCHED, UNMATCHED, PARTIALLY_MATCHED, PENDING_REVIEW

  linkedInvoiceId         String?
  linkedReceivedInvoiceId String?
  linkedPersonId          String?
  linkedReimbursementId   String?
  linkedExpenseId         String?
  linkedLedgerEntryId     String?
  linkedContractType      String?
  linkedContractId        String?
  linkedTaxRecordId       String?

  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([reconciliation])
  @@index([date])
}

model BankDocument {
  id         String   @id @default(cuid())
  type       String // IBAN_LETTER, BANK_CONFIRMATION, STATEMENT, KYC, CORRESPONDENCE, OTHER
  documentId String?
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------------
// 8. General Ledger
// ------------------------------------------------------------------

model LedgerEntry {
  id                String   @id @default(cuid())
  date              DateTime
  type              String // INCOME, EXPENSE, TRANSFER, ADJUSTMENT
  category           String?
  amount            Float
  currency          String   @default("AED")

  clientId          String?
  vendorName        String?
  personId          String?
  paymentMethod     String?
  vat               Float?

  sourceDocumentId  String?
  invoiceId         String?
  bankTransactionId String?

  sourceModule      String? // e.g. Expense, ReceivedInvoice, Invoice, CompensationPayment...
  sourceId          String?

  notes             String?

  createdAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([category])
}

// ------------------------------------------------------------------
// 9. HR / People
// ------------------------------------------------------------------

model Person {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  email                String?
  phone                String?
  role                 String?
  type                 String // FULL_TIME, PART_TIME, FREELANCER, INTERN, CONTRACTOR, OTHER
  dateAdded            DateTime  @default(now())
  contractStart        DateTime?
  contractEnd          DateTime?
  endReason            String?
  status               String    @default("ACTIVE") // ACTIVE, PENDING, COMPLETED, TERMINATED
  visaPermitDate       DateTime?
  compensationAmount   Float?
  compensationCurrency String    @default("AED")
  notes                String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([type])
}

model CompensationPayment {
  id                     String   @id @default(cuid())
  personId               String
  amount                 Float
  currency               String   @default("AED")
  referencePeriod        String?
  paymentDate            DateTime?
  paymentMethod          String?
  status                 String   @default("DUE") // DUE, PAID, PARTIALLY_PAID, OVERDUE
  receiptDocumentId      String?
  signedReceiptDocumentId String?
  ledgerEntryId          String?
  notes                  String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([personId])
  @@index([status])
}

model Reimbursement {
  id             String   @id @default(cuid())
  personId       String
  expenseId      String?
  documentId     String?
  amount         Float
  currency       String   @default("AED")
  category       String?
  expenseDate    DateTime?
  status         String   @default("SUBMITTED") // SUBMITTED, RECORDED, PAID, REJECTED
  ledgerEntryId  String?
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([personId])
  @@index([status])
}

// ------------------------------------------------------------------
// 10. Administration & Tax
// ------------------------------------------------------------------

model TaxRecord {
  id             String    @id @default(cuid())
  docType        String // ADGM_LICENSE, BRANCH_LICENSE, FTA_REGISTRATION, CORPORATE_TAX_REG, VAT_REGISTRATION, CORPORATE_TAX_SUBMISSION, OTHER
  taxRefNumber   String?
  authority      String?
  submissionDate DateTime?
  fiscalPeriod   String?
  issueDate      DateTime?
  nextDueDate    DateTime?
  status         String    @default("PENDING") // PENDING, SUBMITTED, APPROVED, OVERDUE
  documentId     String?
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([nextDueDate])
}

// ------------------------------------------------------------------
// 11. Rent / Office / Lease
// ------------------------------------------------------------------

model RentRecord {
  id               String    @id @default(cuid())
  landlordName     String?
  location         String?
  officeName       String?
  startDate        DateTime?
  endDate          DateTime?
  monthlyRent      Float?
  currency         String    @default("AED")
  paymentSchedule  String?
  deposit          Float?
  noticePeriod     String?
  renewalDate      DateTime?
  contractDocumentId String?
  notes            String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ------------------------------------------------------------------
// 12. Contracts
// ------------------------------------------------------------------

model ReceivedContract {
  id               String    @id @default(cuid())
  counterpartyName String?
  contractType     String?
  signatureDate    DateTime?
  startDate        DateTime?
  endDate          DateTime?
  renewalDate      DateTime?
  noticePeriod     String?
  contractValue    Float?
  currency         String    @default("AED")
  mainObligations  String?
  documentId       String?
  status           String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED, DRAFT
  notes            String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SentContract {
  id             String    @id @default(cuid())
  clientId       String?
  partnerName    String?
  contractType   String?
  packageName    String?
  price          Float?
  currency       String    @default("AED")
  duration       String?
  paymentTerms   String?
  signatureDate  DateTime?
  startDate      DateTime?
  endDate        DateTime?
  renewalDate    DateTime?
  documentId     String?
  invoiceId      String?
  subscriptionId String?
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED, DRAFT
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PlatformPolicy {
  id             String    @id @default(cuid())
  policyName     String
  versionNumber  String?
  approvalDate   DateTime?
  effectiveDate  DateTime?
  reviewDate     DateTime?
  documentId     String?
  status         String    @default("DRAFT") // ACTIVE, ARCHIVED, DRAFT
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PolicyVersion {
  id           String   @id @default(cuid())
  policyId     String
  versionNumber String
  documentId   String?
  changeNotes  String?
  createdAt    DateTime @default(now())

  @@index([policyId])
}
